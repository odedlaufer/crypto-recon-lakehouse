{
  "datasets": [
    {
      "catalog": "crypto_dev",
      "displayName": "slo_tiles",
      "name": "d82aa8ad",
      "queryLines": [
        "WITH completeness AS (\n",
        "  SELECT round(100 * sum(complete_minutes_after)  / sum(minutes), 3) AS repaired_completeness_pct,\n",
        "         round(100 * sum(complete_minutes_before) / sum(minutes), 3) AS raw_completeness_pct,\n",
        "         round(100 * sum(match_minutes)           / sum(minutes), 3) AS match_rate_pct\n",
        "  FROM marts.mart_completeness_hourly\n",
        "  WHERE hour_ts >= current_date() - INTERVAL 7 DAYS\n",
        "),\n",
        "newest_trade AS (\n",
        "  SELECT max(exchange_time) AS exchange_time, max(_ingested_at) AS ingested_at,\n",
        "         count_if(exchange_time >= current_date() - INTERVAL 7 DAYS) AS trades_7d\n",
        "  FROM silver.trades\n",
        "),\n",
        "quarantined AS (\n",
        "  SELECT count(*) AS rows_7d FROM quarantine.trades\n",
        "  WHERE exchange_time >= current_date() - INTERVAL 7 DAYS\n",
        "),\n",
        "producer AS (\n",
        "  SELECT round(percentile(latency_p95_ms, 0.95), 1) AS latency_p95_ms FROM ops.producer_metrics\n",
        "  WHERE window_start >= current_date() - INTERVAL 7 DAYS\n",
        "),\n",
        "repairs AS (\n",
        "  SELECT round(percentile((unix_timestamp(repaired_at) - unix_timestamp(detected_at)) / 3600.0, 0.95), 2) AS gap_repair_p95_h\n",
        "  FROM ops.gaps\n",
        "  WHERE status = 'repaired' AND repaired_at >= current_date() - INTERVAL 7 DAYS\n",
        "),\n",
        "gate AS (\n",
        "  SELECT round(100 * count_if(all_passed) / count(*), 1) AS batch_gate_pass_pct\n",
        "  FROM (SELECT run_id, bool_and(passed) AS all_passed FROM ops.dq_results\n",
        "        WHERE checked_at >= current_date() - INTERVAL 7 DAYS GROUP BY run_id) AS audit_runs\n",
        "),\n",
        "pipeline AS (\n",
        "  SELECT round(100 * count_if(succeeded) / count(*), 1) AS pipeline_success_pct FROM ops.pipeline_runs\n",
        "  WHERE started_at >= current_date() - INTERVAL 7 DAYS\n",
        ")\n",
        "SELECT c.repaired_completeness_pct, c.raw_completeness_pct, c.match_rate_pct,\n",
        "       round((unix_timestamp(n.ingested_at) - unix_timestamp(n.exchange_time)) / 60.0, 1) AS freshness_at_last_load_min,\n",
        "       p.latency_p95_ms, r.gap_repair_p95_h,\n",
        "       round(100 * q.rows_7d / n.trades_7d, 4) AS quarantine_rate_pct,\n",
        "       g.batch_gate_pass_pct, pl.pipeline_success_pct\n",
        "FROM completeness c\n",
        "CROSS JOIN newest_trade n CROSS JOIN quarantined q\n",
        "CROSS JOIN producer p CROSS JOIN repairs r CROSS JOIN gate g CROSS JOIN pipeline pl;"
      ],
      "schema": "default"
    },
    {
      "catalog": "crypto_dev",
      "displayName": "completeness_daily",
      "name": "ea2012d6",
      "queryLines": [
        "SELECT to_date(hour_ts) AS day,\n",
        "       round(100 * sum(complete_minutes_before) / sum(minutes), 3) AS raw_completeness_pct,\n",
        "       round(100 * sum(complete_minutes_after)  / sum(minutes), 3) AS repaired_completeness_pct,\n",
        "       round(100 * sum(match_minutes)           / sum(minutes), 3) AS match_rate_pct\n",
        "FROM marts.mart_completeness_hourly\n",
        "GROUP BY 1 ORDER BY 1;"
      ],
      "schema": "default"
    },
    {
      "catalog": "crypto_dev",
      "displayName": "status_mix_daily",
      "name": "a6197806",
      "queryLines": [
        "SELECT to_date(minute_ts) AS day, status_after_repair AS status, count(*) AS minutes\n",
        "FROM marts.fct_reconciliation_1m\n",
        "GROUP BY ALL ORDER BY day;"
      ],
      "schema": "default"
    },
    {
      "catalog": "crypto_dev",
      "displayName": "gaps_daily",
      "name": "1d78d1c5",
      "queryLines": [
        "SELECT to_date(gap_start_time) AS day, product_id,\n",
        "       count(*) AS gaps, sum(missing_count) AS missing_trades,\n",
        "       count_if(status = 'repaired') AS repaired, count_if(status = 'open') AS open_gaps,\n",
        "       count_if(status = 'unrepairable') AS unrepairable\n",
        "FROM ops.gaps\n",
        "GROUP BY ALL ORDER BY day, product_id;"
      ],
      "schema": "default"
    },
    {
      "catalog": "crypto_dev",
      "displayName": "quarantine_by_rule",
      "name": "fef18651",
      "queryLines": [
        "SELECT to_date(exchange_time) AS day, rule_failed, count(*) AS quarantined_rows\n",
        "FROM quarantine.trades GROUP BY ALL\n",
        "UNION ALL\n",
        "SELECT to_date(received_at) AS day, rule_failed, count(*) AS quarantined_rows\n",
        "FROM quarantine.ws_rejected GROUP BY ALL;"
      ],
      "schema": "default"
    },
    {
      "catalog": "crypto_dev",
      "displayName": "producer_health_hourly",
      "name": "bd0ec942",
      "queryLines": [
        "SELECT date_trunc('HOUR', window_start) AS hour_ts,\n",
        "       round(avg(msgs_per_sec), 1) AS msgs_per_sec,\n",
        "       sum(reconnects) AS reconnects, sum(trade_gaps) AS trade_gaps,\n",
        "       round(percentile(latency_p95_ms, 0.95), 1) AS latency_p95_ms\n",
        "FROM ops.producer_metrics\n",
        "GROUP BY ALL ORDER BY hour_ts;"
      ],
      "schema": "default"
    },
    {
      "catalog": "crypto_dev",
      "displayName": "market_daily",
      "name": "6d6b7444",
      "queryLines": [
        "SELECT product_id, day, realized_vol_pct, trade_count, vwap\n",
        "FROM marts.mart_market_daily\n",
        "ORDER BY day, product_id;"
      ],
      "schema": "default"
    }
  ],
